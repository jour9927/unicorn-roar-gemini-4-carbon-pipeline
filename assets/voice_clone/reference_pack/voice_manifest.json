        {
          "start": 155.43,
          "end": 156.99,
          "text": "马上拿掉台湾只留雕字"
        },
        {
          "start": 156.99,
          "end": 159.23,
          "text": "原来你只是缠他的雕字根本不爱台湾"
        }
