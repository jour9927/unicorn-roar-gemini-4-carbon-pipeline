      "end": 74.14,
      "text": "還說進口貿易跟匯率有關"
    },
    {
      "start": 74.14,
      "end": 75.5,
      "text": "臺幣狂升也就這樣"
    },
    {
      "start": 75.5,
      "end": 78.24,
      "text": "你有看過匯率一番翻了兩三倍嗎"
    },
    {
      "start": 78.24,
      "end": 79.63,
      "text": "你是要升到個位數"
    },
    {
      "start": 79.63,
      "end": 81.09,
      "text": "還是扁到三位數嗎"
    },
    {
      "start": 81.09,
      "end": 82.49,
      "text": "以為匯率是腰股嗎"
    },
    {
      "start": 82.49,
      "end": 84.35,
      "text": "最近人力成本上漲"
    },
    {
      "start": 84.35,
      "end": 86.17,
      "text": "我他媽聽你在放屁"
    },
    {
      "start": 86.17,
      "end": 88.29,
      "text": "紐西蘭薪水有臺灣低嗎"
    },
    {
      "start": 88.29,
      "end": 90.13,
      "text": "人家牛奶有臺灣貴嗎"
    },
    {
      "start": 90.13,
      "end": 97.45,
      "text": "臺灣就是先進國家的物價"
    },
    {
      "start": 97.45,
      "end": 98.81,
      "text": "配上落後國家的薪水"
    },
    {
      "start": 98.81,
      "end": 100.25,
      "text": "還有什麼氣候變"
    },
    {
      "start": 100.25,
      "end": 101.81,
      "text": "千六西蘭奶量下降"
    },
    {
      "start": 101.81,
      "end": 103.77,
      "text": "依錢有關稅配額還要表"
    },
    {
      "start": 103.77,
      "end": 105.07,
      "text": "現在沒配額限制了"
    },
    {
      "start": 105.07,
      "end": 106.29,
      "text": "你怎麼多進口一點"
