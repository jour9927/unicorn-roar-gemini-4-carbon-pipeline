    {
      "start": 106.29,
      "end": 107.77,
      "text": "左手奇亞烙農"
    },
    {
      "start": 107.77,
      "end": 109.31,
      "text": "右手歌消費者韭菜"
    },
    {
      "start": 109.31,
      "end": 111.39,
      "text": "臺灣鮮奶貴是因為品質好"
