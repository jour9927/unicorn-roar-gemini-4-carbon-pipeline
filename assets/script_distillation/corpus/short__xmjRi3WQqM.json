    },
    {
      "start": 25.67,
      "end": 26.67,
      "text": "為什麼?"
    },
    {
      "start": 26.67,
      "end": 27.67,
      "text": "為什麼?"
    },
    {
      "start": 27.67,
      "end": 28.67,
      "text": "你說油價漲了"
    },
    {
      "start": 28.67,
      "end": 29.67,
      "text": "運費漲了"
    },
    {
      "start": 29.67,
      "end": 32.67,
      "text": "還要全程四度C冷鏈運輸"
    },
    {
      "start": 32.67,
